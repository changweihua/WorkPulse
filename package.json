{
  "name": "workpulse",
  "version": "0.2.11",
  "description": "Work log + AI report generator desktop app",
  "author": "changweihua <changweihua@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/changweihua/WorkPulse.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "release": "tsx scripts/sync-version.ts && bumpp",
    "postrelease": "tsx scripts/sync-version.ts",
    "sync-version": "tsx scripts/sync-version.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "prepare": "husky",
    "postinstall": "node scripts/brand-dev-exe.js",
    "commit": "cz",
    "lint:commit": "commitlint --edit"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  },
  "build": {
    "appId": "cmono.workpulse.app",
    "productName": "WorkPulse",
    "copyright": "Copyright © 2026",
    "asar": true,
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "changweihua",
        "repo": "WorkPulse"
      }
    ],
    "files": [
      "out/**/*",
      "!out/renderer/assets/*.map",
      "!node_modules/node-api-dotnet/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/splash.html",
        "to": "splash.html"
      },
      {
        "from": "resources/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "resources/menu-new-log.png",
        "to": "menu-new-log.png"
      },
      {
        "from": "resources/menu-new-task.png",
        "to": "menu-new-task.png"
      },
      {
        "from": "resources/menu-show.png",
        "to": "menu-show.png"
      },
      {
        "from": "resources/menu-quit.png",
        "to": "menu-quit.png"
      },
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "./native/",
        "to": "native/",
        "filter": [
          "**/*.dll",
          "**/*.deps.json",
          "**/*.runtimeconfig.json"
        ]
      },
      {
        "from": "node_modules/node-api-dotnet",
        "to": "node-api-dotnet"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "identity": null
    },
    "dmg": {
      "title": "WorkPulse ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "artifactName": "WorkPulse-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "WorkPulse-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png",
      "category": "Office"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-uikit/core": "^1.1.0",
    "@electron-uikit/titlebar": "^1.4.0",
    "@fauzitech/ai-ui": "^0.1.0",
    "@huggingface/transformers": "^4.2.0",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/tooltip": "^0.99.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.4",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "echarts": "^6.1.0",
    "electron-context-menu": "^4.1.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.34.0",
    "lunar-typescript": "^1.8.6",
    "motion": "^13.1.1",
    "node-api-dotnet": "^0.9.26",
    "onnxruntime-web": "^1.27.0",
    "openai": "^7.5.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-use": "^17.6.1",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "bmp-js": "^0.1.0",
    "bumpp": "^12.2.1",
    "commitizen": "^4.3.2",
    "commitlint-config-git-commit-emoji": "^1.0.0",
    "cross-env": "^10.1.0",
    "cz-customizable": "^7.5.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "husky": "^9.1.7",
    "rcedit": "^5.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.12",
    "tw-prose": "^0.0.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-env-parse": "^1.0.15"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true,
    "better-sqlite3": true
  }
}
